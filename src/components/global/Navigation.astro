---
import { Icon } from "astro-icon/components";
import Logo from "/public/tmlogo.svg";
---

<style>
  .logo-animation {
    animation: logo-animation 1s forwards;
  }
  @keyframes logo-animation {
    0% {
      opacity: 0.2;
      width: 0%;
    }
    100% {
      opacity: 1;
      width: 100%;
    }
  }
